@page
@model RazoAir.Web.Pages.Booking.LookupModel
@{
    ViewData["Title"] = "My Booking";
}

<section class="narrow-section">
    <h1 class="page-title">Find your booking</h1>
    <p class="muted">Enter your booking reference and the email you used to book.</p>

    @if (Model.ErrorMessage is not null)
    {
        <p class="alert-error">@Model.ErrorMessage</p>
    }

    <form method="post" class="stacked-form">
        <div class="field">
            <label asp-for="Reference">Booking reference</label>
            <input asp-for="Reference" placeholder="e.g. 7K3P2M" maxlength="6" style="text-transform:uppercase" required />
            <span asp-validation-for="Reference" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" placeholder="you@example.com" required />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-accent">Find ticket</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
