@page
@model RazoAir.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log In";
}

<section class="narrow-section">
    <h1 class="page-title">Welcome back</h1>
    <p class="muted">Log in with your email and password.</p>

    @if (Model.ErrorMessage is not null)
    {
        <p class="alert-error">@Model.ErrorMessage</p>
    }

    <form method="post" class="stacked-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <div class="field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" type="email" placeholder="you@example.com" autocomplete="email" required />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <label class="checkbox-field">
            <input asp-for="Input.RememberMe" type="checkbox" />
            <span>Remember me</span>
        </label>

        <button type="submit" class="btn btn-accent">Log in</button>
    </form>

    <p class="muted" style="margin-top:16px;">Don't have an account? <a asp-page="/Account/Register" style="color:var(--color-accent);font-weight:600;">Sign up</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
