@page
@model RazoAir.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Sign Up";
}

<section class="narrow-section">
    <h1 class="page-title">Create your account</h1>
    <p class="muted">Sign up with just your email and a password. You can add a phone number and avatar later from your account page.</p>

    <form method="post" class="stacked-form">
        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <div class="field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" type="email" placeholder="you@example.com" autocomplete="email" required />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" type="password" autocomplete="new-password" required />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.ConfirmPassword">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-accent">Create account</button>
    </form>

    <p class="muted" style="margin-top:16px;">Already have an account? <a asp-page="/Account/Login" style="color:var(--color-accent);font-weight:600;">Log in</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
