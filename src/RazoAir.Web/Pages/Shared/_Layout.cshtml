@using Microsoft.AspNetCore.Identity
@using RazoAir.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string prefix) => currentPath.Equals("/", StringComparison.OrdinalIgnoreCase)
        ? prefix == "/"
        : prefix != "/" && currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — RazoAir</title>
    <script>
        (function () {
            var saved = localStorage.getItem('razoair-theme');
            if (saved === 'light' || saved === 'dark') {
                document.documentElement.setAttribute('data-theme', saved);
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container site-header-inner">
            <a class="brand" asp-area="" asp-page="/Index">RazoAir</a>
            <nav class="site-nav" aria-label="Main navigation">
                <a asp-area="" asp-page="/Flights/Search" class="@(IsActive("/Flights") ? "active" : "")">Flights</a>
                <a asp-area="" asp-page="/Pilots/Index" class="@(IsActive("/Pilots") ? "active" : "")">Pilots</a>
                <a asp-area="" asp-page="/Airlines/Index" class="@(IsActive("/Airlines") ? "active" : "")">Airlines</a>
                <a asp-area="" asp-page="/Booking/Lookup" class="@(IsActive("/Booking") ? "active" : "")">My Booking</a>
            </nav>
            <div class="header-actions">
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <a class="header-account" asp-page="/Account/Manage">
                        @if (currentUser?.AvatarFileName is not null)
                        {
                            <img class="header-avatar" src="~/uploads/avatars/@currentUser.AvatarFileName" alt="" />
                        }
                        else
                        {
                            <span class="header-avatar-fallback">@(currentUser?.Email?.Substring(0, 1).ToUpperInvariant())</span>
                        }
                        <span>My account</span>
                    </a>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="link-btn">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login" class="link-btn">Log in</a>
                    <a asp-page="/Account/Register" class="btn btn-accent" style="padding:8px 18px;">Sign up</a>
                }
                <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                    <span class="theme-toggle-icon" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </header>

    <div class="container site-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container site-footer-inner">
            <span>&copy; @DateTime.Now.Year RazoAir · a student project built with ASP.NET Core Razor Pages</span>
            <span class="muted">razoair.local</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
